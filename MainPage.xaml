<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FrecuenciaCardiaca.MainPage">

	<StackLayout>
		<Frame BackgroundColor="#2196F3" Padding="24" CornerRadius="0">
			<Label Text="Frecuencia Cardiaca" HorizontalTextAlignment="Center" TextColor="White" FontSize="36"/>
		</Frame>

		<Entry Placeholder="Latidos" x:Name="Latidos" Keyboard="Numeric"/>
		<Label x:Name="Frecuencia" Text="Frecuencia" IsEnabled="False"/>
		<Button Text="Calcular" Clicked="Button_Clicked"/>

	</StackLayout>

</ContentPage>
